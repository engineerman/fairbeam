{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Fairbeam: Restart serve",
      "type": "shell",
      "command": "${workspaceFolder}\\scripts\\restart-fairbeam-serve.ps1",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
